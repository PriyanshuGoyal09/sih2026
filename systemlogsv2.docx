import numpy as np

from scheduler.bandit import UCBScanner
from prediction.transition_model import BandTransitionModel


class SmartScanScheduler:
    """
    SmartScan v2.

    Combines:
        1. Band-level learning using UCB
        2. Temporal frequency prediction
        3. Exploration of poorly known bands

    The scheduler uses receiver observations only.
    """

    def __init__(
        self,
        num_bands: int,
        exploration: float = 2.0,
        prediction_weight: float = 1.5,
        seed: int = 2026
    ):

        self.num_bands = num_bands

        self.prediction_weight = (
            prediction_weight
        )

        self.rng = np.random.default_rng(
            seed
        )

        self.bandit = UCBScanner(
            num_bands=num_bands,
            exploration=exploration,
            seed=seed
        )

        self.predictor = BandTransitionModel(
            num_bands=num_bands
        )

        self.last_detection_band = None

    def reset(self):

        self.bandit.reset()

        self.predictor.reset()

        self.last_detection_band = None

    def update(
        self,
        band: int,
        detected: bool,
        measured_power_dbm: float,
        false_alarm: bool = False
    ):

        self.bandit.update(
            band=band,
            detected=detected,
            measured_power_dbm=measured_power_dbm,
            false_alarm=false_alarm
        )

        # False alarms are not treated as emitter transitions.
        if not false_alarm:

            self.predictor.update(
                band=band,
                detected=detected
            )

            if detected:
                self.last_detection_band = band

    def next_band(self) -> int:

        ucb_scores = np.array([
            self.bandit._ucb_score(band)
            for band in range(
                self.num_bands
            )
        ])

        # Normalize UCB scores.
        ucb_min = np.min(
            ucb_scores
        )

        ucb_max = np.max(
            ucb_scores
        )

        if ucb_max > ucb_min:

            ucb_normalized = (
                ucb_scores - ucb_min
            ) / (
                ucb_max - ucb_min
            )

        else:

            ucb_normalized = np.zeros(
                self.num_bands
            )

        # Temporal prediction.
        prediction_scores = np.zeros(
            self.num_bands
        )

        if self.last_detection_band is not None:

            prediction_scores = (
                self.predictor.predict_next(
                    self.last_detection_band
                )
            )

        # Combined SmartScan score.
        scores = (
            ucb_normalized
            + self.prediction_weight
            * prediction_scores
        )

        # Small random noise breaks ties.
        scores += self.rng.normal(
            0.0,
            1e-6,
            self.num_bands
        )

        return int(
            np.argmax(scores)
        )

    def get_statistics(self):

        return {
            "bandit": self.bandit.get_statistics(),
            "transition_matrix":
                self.predictor.get_transition_matrix()
        }
