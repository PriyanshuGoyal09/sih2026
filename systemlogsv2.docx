import numpy as np

from scheduler.bandit import UCBScanner
from prediction.transition_model import BandTransitionModel


class SmartScanScheduler:
    """
    SmartScan V2.

    Combines:
        1. UCB-based band learning
        2. Temporal transition prediction
        3. Exploration of uncertain bands

    The scheduler receives only simulated receiver/detector
    observations. Ground-truth occupancy is never provided to it.
    """

    def __init__(
        self,
        num_bands: int,
        exploration: float = 2.0,
        prediction_weight: float = 1.5,
        seed: int = 2026
    ):

        if num_bands <= 0:
            raise ValueError("num_bands must be positive")

        self.num_bands = num_bands
        self.prediction_weight = prediction_weight

        self.rng = np.random.default_rng(seed)

        self.bandit = UCBScanner(
            num_bands=num_bands,
            exploration=exploration,
            seed=seed
        )

        self.predictor = BandTransitionModel(
            num_bands=num_bands
        )

        self.last_detection_band = None

    def reset(self):
        """Reset all scheduler learning state."""

        self.bandit.reset()
        self.predictor.reset()

        self.last_detection_band = None

    def update(
        self,
        band: int,
        detected: bool,
        measured_power_dbm: float,
        false_alarm: bool = False
    ):
        """
        Update SmartScan using the receiver observation.

        Parameters
        ----------
        band:
            Band that was scanned.

        detected:
            Detector output.

        measured_power_dbm:
            Measured received power.

        false_alarm:
            Whether the detector classified the detection
            as a false alarm.
        """

        if not 0 <= band < self.num_bands:
            raise ValueError("Invalid band.")

        # Update band-level UCB learner.
        self.bandit.update(
            band=band,
            detected=detected,
            measured_power_dbm=measured_power_dbm,
            false_alarm=false_alarm
        )

        # Do not teach the temporal model from false alarms.
        if false_alarm:
            return

        # Learn temporal relationships only from real detections.
        self.predictor.update(
            band=band,
            detected=detected
        )

        if detected:
            self.last_detection_band = band

    def _get_normalized_ucb_scores(self):
        """
        Calculate normalized UCB scores safely.

        Handles infinity values during the initial exploration phase.
        """

        ucb_scores = np.array(
            [
                self.bandit._ucb_score(band)
                for band in range(self.num_bands)
            ],
            dtype=float
        )

        finite_mask = np.isfinite(ucb_scores)

        normalized = np.zeros(
            self.num_bands,
            dtype=float
        )

        # If all values are infinite, there is no learned
        # UCB information yet.
        if not np.any(finite_mask):
            return normalized

        finite_values = ucb_scores[finite_mask]

        minimum = np.min(finite_values)
        maximum = np.max(finite_values)

        if maximum > minimum:

            normalized[finite_mask] = (
                ucb_scores[finite_mask] - minimum
            ) / (
                maximum - minimum
            )

        else:

            normalized[finite_mask] = 0.0

        # Unvisited bands should remain attractive during exploration.
        normalized[~finite_mask] = 1.0

        return normalized

    def _get_prediction_scores(self):
        """
        Calculate predicted next-band probabilities.
        """

        prediction_scores = np.zeros(
            self.num_bands,
            dtype=float
        )

        if self.last_detection_band is None:
            return prediction_scores

        prediction_scores = (
            self.predictor.predict_next(
                self.last_detection_band
            )
        )

        return prediction_scores

    def next_band(self) -> int:
        """
        Select the next frequency band.

        SmartScore =
            normalized UCB score
            +
            prediction weight × temporal prediction
        """

        ucb_scores = (
            self._get_normalized_ucb_scores()
        )

        prediction_scores = (
            self._get_prediction_scores()
        )

        smart_scores = (
            ucb_scores
            +
            self.prediction_weight
            * prediction_scores
        )

        # Tiny random noise only breaks exact ties.
        smart_scores = (
            smart_scores
            + self.rng.normal(
                0.0,
                1e-6,
                self.num_bands
            )
        )

        return int(
            np.argmax(smart_scores)
        )

    def get_scores(self):
        """
        Return current SmartScan scores for debugging
        and dashboard visualization.
        """

        ucb_scores = (
            self._get_normalized_ucb_scores()
        )

        prediction_scores = (
            self._get_prediction_scores()
        )

        smart_scores = (
            ucb_scores
            +
            self.prediction_weight
            * prediction_scores
        )

        return {
            "ucb_scores": ucb_scores,
            "prediction_scores": prediction_scores,
            "smart_scores": smart_scores
        }

    def get_statistics(self):
        """
        Return scheduler statistics.
        """

        return {
            "bandit": self.bandit.get_statistics(),
            "transition_matrix":
                self.predictor.get_transition_matrix(),
            "last_detection_band":
                self.last_detection_band
        }
