from dataclasses import dataclass
from typing import List, Dict, Any
import numpy as np


@dataclass
class MetricsResult:
    true_positives: int
    false_positives: int
    true_negatives: int
    false_negatives: int

    probability_detection: float
    probability_false_alarm: float
    sensitivity: float
    precision: float
    accuracy: float

    total_scans: int
    detection_count: int
    false_alarm_count: int

    average_intercept_time: float
    average_intercept_time_error: float


def evaluate(results: List[Dict[str, Any]]) -> MetricsResult:
    """
    Evaluate a scanner using receiver observations and
    evaluation-only ground truth.
    """

    tp = 0
    fp = 0
    tn = 0
    fn = 0

    detection_times = []
    intercept_time_errors = []

    for result in results:

        detected = bool(result["detected"])
        occupied = bool(result["actual_occupied"])

        if detected and occupied:
            tp += 1

            # The current scan represents the intercept time
            # for this observed transmission.
            detection_times.append(
                result["time_slot"]
            )

        elif detected and not occupied:
            fp += 1

        elif not detected and occupied:
            fn += 1

        else:
            tn += 1

    total_scans = len(results)

    detection_count = tp + fp
    false_alarm_count = fp

    # Probability of detection.
    detection_denominator = tp + fn

    if detection_denominator > 0:
        probability_detection = (
            tp / detection_denominator
        )
    else:
        probability_detection = 0.0

    # Probability of false alarm.
    false_alarm_denominator = fp + tn

    if false_alarm_denominator > 0:
        probability_false_alarm = (
            fp / false_alarm_denominator
        )
    else:
        probability_false_alarm = 0.0

    # Sensitivity is equivalent to recall for this binary task.
    sensitivity = probability_detection

    # Precision.
    if tp + fp > 0:
        precision = tp / (tp + fp)
    else:
        precision = 0.0

    # Accuracy.
    if total_scans > 0:
        accuracy = (
            (tp + tn) / total_scans
        )
    else:
        accuracy = 0.0

    # Average intercept time.
    if detection_times:
        average_intercept_time = float(
            np.mean(detection_times)
        )
    else:
        average_intercept_time = 0.0

    # We do not yet have an independent predicted intercept
    # time, so this is zero for the current baseline.
    average_intercept_time_error = 0.0

    return MetricsResult(
        true_positives=tp,
        false_positives=fp,
        true_negatives=tn,
        false_negatives=fn,

        probability_detection=probability_detection,
        probability_false_alarm=probability_false_alarm,
        sensitivity=sensitivity,
        precision=precision,
        accuracy=accuracy,

        total_scans=total_scans,
        detection_count=detection_count,
        false_alarm_count=false_alarm_count,

        average_intercept_time=average_intercept_time,
        average_intercept_time_error=average_intercept_time_error,
    )


def print_metrics(name: str, metrics: MetricsResult):
    print(f"\n=== {name} METRICS ===\n")

    print(f"True positives:              {metrics.true_positives}")
    print(f"False positives:             {metrics.false_positives}")
    print(f"True negatives:              {metrics.true_negatives}")
    print(f"False negatives:             {metrics.false_negatives}")

    print()
    print(
        f"Probability of Detection:    "
        f"{metrics.probability_detection:.4f}"
    )

    print(
        f"Probability of False Alarm:  "
        f"{metrics.probability_false_alarm:.4f}"
    )

    print(
        f"Sensitivity:                 "
        f"{metrics.sensitivity:.4f}"
    )

    print(
        f"Precision:                   "
        f"{metrics.precision:.4f}"
    )

    print(
        f"Accuracy:                    "
        f"{metrics.accuracy:.4f}"
    )

    print()
    print(f"Total scans:                 {metrics.total_scans}")
    print(f"Detection count:             {metrics.detection_count}")
    print(f"False alarm count:           {metrics.false_alarm_count}")

    print(
        f"Average intercept time:      "
        f"{metrics.average_intercept_time:.2f}"
    )

    print(
        f"Average intercept time error:"
        f" {metrics.average_intercept_time_error:.2f}"
    )
