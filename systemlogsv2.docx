(.venv) [ashwin@ideapad warfare]$ cat > metrics/evaluation.py <<'PY'
from dataclasses import dataclass
from typing import List, Dict, Any
import numpy as np


@dataclass
class MetricsResult:
    true_positives: int
    false_positives: int
    true_negatives: int
    false_negatives: int

    probability_detection: float
    probability_false_alarm: float
    sensitivity: float
    precision: float
    accuracy: float

    total_scans: int
    detection_count: int
    false_alarm_count: int

    total_transmission_events: int
    intercepted_events: int
    missed_events: int

    average_intercept_time: float
    average_intercept_time_error: float
    maximum_intercept_time: float


def find_transmission_events(results: List[Dict[str, Any]]):
    """
    Identify continuous transmission events for each frequency band.

    A transmission event begins when a band becomes occupied and ends
    when that band becomes unoccupied.
    """

    occupied = {}

    for result in results:
        band = result["band"]
        time_slot = result["time_slot"]

        if result["actual_occupied"]:
            occupied.setdefault(band, []).append(time_slot)

    events = []

    for band, times in occupied.items():

        times = sorted(times)

        if not times:
            continue

        start = times[0]
        previous = times[0]

        for current in times[1:]:

            if current != previous + 1:
                events.append({
                    "band": band,
                    "start_time": start,
                    "end_time": previous
                })

                start = current

            previous = current

        events.append({
            "band": band,
            "start_time": start,
            "end_time": previous
        })

    return events


def evaluate(results: List[Dict[str, Any]]) -> MetricsResult:

    tp = 0
    fp = 0
    tn = 0
    fn = 0

    for result in results:

        detected = bool(result["detected"])
        occupied = bool(result["actual_occupied"])

        if detected and occupied:
            tp += 1

        elif detected and not occupied:
            fp += 1

        elif not detected and occupied:
            fn += 1

        else:
            tn += 1

    total_scans = len(results)

    detection_count = tp + fp
    false_alarm_count = fp

    # Event-level analysis.
    events = find_transmission_events(results)

    intercepted_events = 0
    intercept_delays = []

    for event in events:

        matching_detections = [
            r["time_slot"]
            for r in results
            if (
                r["band"] == event["band"]
                and r["detected"]
                and event["start_time"]
                <= r["time_slot"]
                <= event["end_time"]
            )
        ]

        if matching_detections:

            first_detection = min(matching_detections)

            delay = (
                first_detection
                - event["start_time"]
            )

            intercepted_events += 1
            intercept_delays.append(delay)

    total_transmission_events = len(events)

    missed_events = (
        total_transmission_events
        - intercepted_events
    )

    # Event-level probability of detection.
    if total_transmission_events > 0:
        probability_detection = (
            intercepted_events
            / total_transmission_events
        )
    else:
        probability_detection = 0.0

    # Scan-level probability of false alarm.
    false_alarm_denominator = fp + tn

    if false_alarm_denominator > 0:
        probability_false_alarm = (
            fp / false_alarm_denominator
        )
    else:
        probability_false_alarm = 0.0

    sensitivity = probability_detection

    if tp + fp > 0:
        precision = tp / (tp + fp)
    else:
        precision = 0.0

    if total_scans > 0:
        accuracy = (tp + tn) / total_scans
    else:
        accuracy = 0.0

    if intercept_delays:
        average_intercept_time = float(
            np.mean(intercept_delays)
        )

        maximum_intercept_time = float(
            np.max(intercept_delays)
        )
    else:
        average_intercept_time = 0.0
        maximum_intercept_time = 0.0

    # Prediction error will be implemented when we introduce
    # the behaviour prediction component.
    average_intercept_time_error = 0.0

    return MetricsResult(
        true_positives=tp,
        false_positives=fp,
        true_negatives=tn,
        false_negatives=fn,

        probability_detection=probability_detection,
        probability_false_alarm=probability_false_alarm,
        sensitivity=sensitivity,
        precision=precision,
        accuracy=accuracy,

        total_scans=total_scans,
        detection_count=detection_count,
        false_alarm_count=false_alarm_count,

        total_transmission_events=total_transmission_events,
        intercepted_events=intercepted_events,
        missed_events=missed_events,

        average_intercept_time=average_intercept_time,
        average_intercept_time_error=average_intercept_time_error,
        maximum_intercept_time=maximum_intercept_time,
    )


def print_metrics(name: str, metrics: MetricsResult):

    print(f"\n=== {name} METRICS ===\n")

    print(
        f"True positives:              "
        f"{metrics.true_positives}"
    )

    print(
        f"False positives:             "
        f"{metrics.false_positives}"
    )

    print(
        f"True negatives:              "
        f"{metrics.true_negatives}"
    )

    print(
        f"False negatives:             "
        f"{metrics.false_negatives}"
    )

    print()

    print(
        f"Probability of Detection:    "
        f"{metrics.probability_detection:.4f}"
    )

    print(
        f"Probability of False Alarm:  "
        f"{metrics.probability_false_alarm:.4f}"
    )

    print(
        f"Sensitivity:                 "
        f"{metrics.sensitivity:.4f}"
    )

    print(
        f"Precision:                   "
        f"{metrics.precision:.4f}"
    )

    print(
        f"Accuracy:                    "
        f"{metrics.accuracy:.4f}"
    )

    print()

    print(
        f"Total transmission events:   "
        f"{metrics.total_transmission_events}"
    )

    print(
        f"Intercepted events:          "
        f"{metrics.intercepted_events}"
    )

    print(
        f"Missed events:               "
        f"{metrics.missed_events}"
    )

    print()

    print(
        f"Average intercept time:      "
        f"{metrics.average_intercept_time:.2f} slots"
    )

    print(
        f"Maximum intercept time:      "
        f"{metrics.maximum_intercept_time:.2f} slots"
    )

    print(
        f"Average intercept time error:"
        f" {metrics.average_intercept_time_error:.2f}"
    )
